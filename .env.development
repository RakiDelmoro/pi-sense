# Dashboard server
PORT=3141

# InfluxDB
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=pi-sense-dev-token # ⚠️ change this in production
INFLUX_ORG=pi-sense
INFLUX_BUCKET=pi-sense

# InfluxDB initialization (only used on first run)
INFLUXDB_ADMIN_USERNAME=admin # ⚠️ change this in production
INFLUXDB_ADMIN_PASSWORD=pi-sense-admin # ⚠️ change this in production

# MQTT
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=pi-sense-dev # ⚠️ change this in production
MQTT_PASSWORD=pi-sense-dev-123 # ⚠️ change this in production
