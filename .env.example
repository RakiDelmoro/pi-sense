# Pi Sense environment variables
# Copy this file to .env and fill in real values for production

# Dashboard server
PORT=3141

# InfluxDB
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=change-me-in-production
INFLUX_ORG=pi-sense
INFLUX_BUCKET=pi-sense

# InfluxDB initialization (only used on first run)
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=change-me-in-production

# MQTT
MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC_PREFIX="pi-sensors/#"
MQTT_USERNAME=change-me-in-production
MQTT_PASSWORD=change-me-in-production
