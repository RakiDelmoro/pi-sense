# ── Stage 1: Build ──────────────────────────────────────────────
FROM oven/bun:1.3 AS build

WORKDIR /app

# Install dependencies first (layer cache)
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

# Copy source and sensor definition (sensor configs drive ingest metadata)
COPY src/ src/
COPY sensors/ sensors/
COPY tsconfig.json ./

# ── Stage 2: Run ───────────────────────────────────────────────
FROM oven/bun:1.3-slim

WORKDIR /app

# Install only production dependencies
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile --production

# Copy the adapter entrypoint, ingest loop, shared MQTT client + topic
# metadata, and InfluxDB write API. Sensor configs drive ingest metadata.
COPY src/adapter/ src/adapter/
COPY src/mqtt/ src/mqtt/
COPY src/influx/ src/influx/
COPY sensors/ sensors/

# Run as non-root user for security
RUN groupadd -r app && useradd -r -g app app
USER app

CMD ["bun", "src/adapter/adapter.ts"]
